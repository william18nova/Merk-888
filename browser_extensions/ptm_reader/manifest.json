{
  "manifest_version": 3,
  "name": "NovaPOS · Lector PTM",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "description": "Consulta reportes PTM y los envía a conciliación. No realiza transacciones.",
  "permissions": ["alarms", "storage"],
  "host_permissions": ["https://ptm.transacciones.com.co/*"],
  "optional_host_permissions": ["https://*/*", "http://127.0.0.1/*", "http://localhost/*"],
  "background": {"service_worker": "background.js"},
  "options_page": "options.html",
  "action": {"default_title": "Configurar lector PTM"},
  "content_scripts": [{
    "matches": ["https://ptm.transacciones.com.co/DistribuidoresTFCC/controller/FCConsultaTransacciones*", "https://ptm.transacciones.com.co/DistribuidoresTFCC/controller/FCVentaServicios"],
    "all_frames": true,
    "js": ["parser.js", "content.js"],
    "run_at": "document_idle"
  }]
}
