# Archivo de referencia. Django no carga este archivo automáticamente:
# exporta estas variables en el entorno privado del servidor.
PRICE_SYNC_SOURCE_HOST=
PRICE_SYNC_SOURCE_PORT=5432
PRICE_SYNC_SOURCE_NAME=
PRICE_SYNC_SOURCE_USER=
PRICE_SYNC_SOURCE_PASSWORD=
PRICE_SYNC_SOURCE_SSLMODE=require
# PRICE_SYNC_SOURCE_SSLROOTCERT=/ruta/privada/ca.pem

# Opcionales (deja PRICE_SYNC_MAPPING_FILE sin definir para usar el mapa incluido)
# PRICE_SYNC_MAPPING_FILE=/ruta/privada/price_sync_plaza_map.json
PRICE_SYNC_CONNECT_TIMEOUT=10
PRICE_SYNC_STATEMENT_TIMEOUT_MS=30000
PRICE_SYNC_MAX_PRICE_FACTOR=5

# Bot inteligente de Telegram (mantén los valores reales fuera de Git)
# TELEGRAM_ENV_FILE=/ruta/privada/.telegram_bot.env
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Opcional; si queda vacío se usa https://TU_DOMINIO/api/telegram/webhook/
TELEGRAM_WEBHOOK_URL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# Respaldos en orden. Quitar un nombre lo desactiva; sin clave se omite.
TELEGRAM_TEXT_PROVIDERS=gemini,groq,cerebras,openrouter
TELEGRAM_VOICE_PROVIDERS=groq,azure,deepgram,assemblyai,gemini
CEREBRAS_API_KEY=
CEREBRAS_CHAT_MODEL=gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=openai/gpt-oss-120b:free
GEMINI_AUDIO_MODEL=gemini-3.8-flash
AZURE_SPEECH_KEY=
# Solo nombre del recurso, sin https ni dominio.
AZURE_SPEECH_RESOURCE=
AZURE_SPEECH_FREE_TIER_CONFIRMED=false
TELEGRAM_FFMPEG_BIN=ffmpeg
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_TRIAL_CONFIRMED=false
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_MODEL=universal-2
ASSEMBLYAI_TRIAL_CONFIRMED=false
